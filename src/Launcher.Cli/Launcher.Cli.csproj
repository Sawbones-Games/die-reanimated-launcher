<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless driver over Launcher.Core: the same state machine and actions as the desktop launcher, for
       scripts, CI and diagnosis. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>die-launcher</AssemblyName>
    <RootNamespace>DieReanimated.Launcher.Cli</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

</Project>
