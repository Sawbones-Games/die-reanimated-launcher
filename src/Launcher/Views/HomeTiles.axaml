<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DieReanimated.Launcher.Ui.ViewModels"
             xmlns:v="using:DieReanimated.Launcher.Ui.Views"
             x:Class="DieReanimated.Launcher.Ui.Views.HomeTiles"
             x:DataType="vm:LauncherViewModel">
  <!-- Home's bottom rail: up to two more news items, then what is live now (→ Servers). -->
  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">

    <ItemsControl ItemsSource="{Binding Tiles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LauncherViewModel+NewsVm">
          <Button Classes="tile" Click="OnTile">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="thumb" Height="76" BorderThickness="0,0,0,1" ClipToBounds="True">
                <v:FocusImage Source="{Binding Image}" FocalPoint="{Binding Focus}" Opacity="0.9"/>
              </Border>
              <StackPanel Margin="10,7,10,9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Kind}" Classes="label" FontSize="9" LetterSpacing="1.3"/>
                  <TextBlock Grid.Column="1" Text="{Binding DateShort}" Classes="label" FontSize="9" LetterSpacing="1.3"
                             Foreground="{Binding Kind, Converter={x:Static v:Conv.KindBrush}}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" LineHeight="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource B.Bone}"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- live now -->
    <Button Classes="tile" Click="OnLive">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="thumb" Height="76" BorderThickness="0,0,0,1" ClipToBounds="True">
          <v:FocusImage Source="{Binding LiveNowArt}" Opacity="0.9"/>
        </Border>
        <StackPanel Margin="10,7,10,9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="LIVE NOW" Classes="label" FontSize="9" LetterSpacing="1.3"/>
            <TextBlock Grid.Column="1" Text="{Binding LiveNowRegions}" Classes="label" FontSize="9" LetterSpacing="1.3" Foreground="{StaticResource B.Green}"/>
          </Grid>
          <TextBlock Text="{Binding LiveNowText}" FontSize="12" FontWeight="SemiBold" LineHeight="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource B.Bone}"/>
        </StackPanel>
      </DockPanel>
    </Button>
  </StackPanel>
</UserControl>
