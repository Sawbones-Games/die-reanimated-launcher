<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop launcher: one window over Launcher.Core. Everything it decides and does is in Core (the CLI
    is the same code without the window); this project is the screens, the fonts and the window chrome.
    Published self-contained, single file, as DIE-Reanimated-Launcher.exe — the file a player drops over the
    retail launcher.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DIE-Reanimated-Launcher</AssemblyName>
    <RootNamespace>DieReanimated.Launcher.Ui</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the file icon (Explorer, the taskbar, Steam's shortcut): ours, rendered by tools/make-icon.py -->
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Trimming is off on purpose: Cecil and reflection-bound XAML are not worth the audit surface for ~60 MB. -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- no ICU: every date the launcher formats is invariant (see LauncherViewModel.NewsVm) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

</Project>
